# Files Git should never track in this repository.
# Rule of thumb: commit what a person wrote, ignore what a tool generated
# and anything private.

# --- Compiled Java output (rebuilt from source, so never committed) ---
*.class
*.jar
*.war
target/
build/
out/
bin/

# --- IDE and editor settings (personal to each developer) ---
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# --- Operating system files ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Secrets and local configuration (must never reach GitHub) ---
.env
.env.*
*.key
*.pem

# --- Logs and temporary files ---
*.log
*.tmp
*.bak
*.swp
